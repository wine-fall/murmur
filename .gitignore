# Node
node_modules/

# Python (the dev scripts under scripts/ still run on system python3)
__pycache__/

# Tooling / OS
.DS_Store

# Throwaway smoke/probe scripts (murmur-smoke skill) — never committed
scratch/
.github/hooks/

# graphify knowledge-graph artifacts — rebuilt locally by the post-commit hook
graphify-out/

# Local dev session artifacts (make dev): the tailed diagnostics log
.dev/

# Local-only env configs (endpoints/keys) — .env is generated from .env.<backend>
# by `make dev-fishaudio` / `make dev-opuslab`; never commit any of them.
.env*
